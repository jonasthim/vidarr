{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Host (debug)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Vidarr.Host/bin/Debug/net10.0/Vidarr.Host.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/Vidarr.Host",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5027",
        "VIDARR_API_KEY": "dev-key"
      },
      "console": "internalConsole",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    },
    {
      "name": "Web (Vite, Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/src/Vidarr.Web/src"
    }
  ],
  "compounds": [
    {
      "name": "Full dev",
      "configurations": ["Host (debug)", "Web (Vite, Chrome)"],
      "preLaunchTask": "vite-dev",
      "stopAll": true
    }
  ]
}
