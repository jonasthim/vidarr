<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
    <UserSecretsId>vidarr-host-secrets</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vidarr.Api\Vidarr.Api.csproj" />
    <ProjectReference Include="..\Vidarr.Catalog\Vidarr.Catalog.csproj" />
    <ProjectReference Include="..\Vidarr.ChapterSplit\Vidarr.ChapterSplit.csproj" />
    <ProjectReference Include="..\Vidarr.Contracts\Vidarr.Contracts.csproj" />
    <ProjectReference Include="..\Vidarr.Decision\Vidarr.Decision.csproj" />
    <ProjectReference Include="..\Vidarr.DownloadClients\Vidarr.DownloadClients.csproj" />
    <ProjectReference Include="..\Vidarr.EventBus\Vidarr.EventBus.csproj" />
    <ProjectReference Include="..\Vidarr.Importer\Vidarr.Importer.csproj" />
    <ProjectReference Include="..\Vidarr.Indexers\Vidarr.Indexers.csproj" />
    <ProjectReference Include="..\Vidarr.Infrastructure\Vidarr.Infrastructure.csproj" />
    <ProjectReference Include="..\Vidarr.Metadata\Vidarr.Metadata.csproj" />
    <ProjectReference Include="..\Vidarr.Naming\Vidarr.Naming.csproj" />
    <ProjectReference Include="..\Vidarr.Notifications\Vidarr.Notifications.csproj" />
    <ProjectReference Include="..\Vidarr.Rules\Vidarr.Rules.csproj" />
    <ProjectReference Include="..\Vidarr.Scheduler\Vidarr.Scheduler.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <PropertyGroup>
    <WebDir>$(MSBuildThisFileDirectory)..\Vidarr.Web\</WebDir>
    <WebDistDir>$(WebDir)dist\</WebDistDir>
    <WebWwwroot>$(MSBuildThisFileDirectory)wwwroot\</WebWwwroot>
    <SkipWebBuild Condition="'$(SkipWebBuild)' == ''">false</SkipWebBuild>
  </PropertyGroup>

  <Target Name="BuildVidarrWeb" BeforeTargets="Build" Condition="'$(SkipWebBuild)' != 'true' And Exists('$(WebDir)package.json')">
    <Exec Command="npm install --no-audit --no-fund --silent" WorkingDirectory="$(WebDir)" Condition="!Exists('$(WebDir)node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(WebDir)" />
    <ItemGroup>
      <_WebOutput Include="$(WebDistDir)**\*.*" />
    </ItemGroup>
    <RemoveDir Directories="$(WebWwwroot)" Condition="Exists('$(WebWwwroot)')" />
    <Copy SourceFiles="@(_WebOutput)" DestinationFiles="@(_WebOutput->'$(WebWwwroot)%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

</Project>
